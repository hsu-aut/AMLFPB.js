<UserControl
    x:Class="Aml.Editor.Plugin.FPB.Views.IhView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:local="clr-namespace:Aml.Editor.Plugin.FPB.Views"
    mc:Ignorable="d"
    d:DesignHeight="500" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160" MinHeight="60"/>
        </Grid.RowDefinitions>

        <!-- Local toolbar: compact icon buttons matching the editor's native side
             panels (Segoe MDL2 Assets glyphs in coloured boxes, mouse-over reveals
             the action label via tooltip). -->
        <!-- The status has a line of its own below the toolbar: in the editor's
             narrow pane the ToolBar put it into its overflow, where nobody saw it
             (016f E3, run in the real editor). -->
        <DockPanel Grid.Row="0">
        <TextBlock x:Name="StatusLabel"
                   DockPanel.Dock="Bottom"
                   Text=""
                   Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                   FontStyle="Italic"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                   Margin="8,0,8,3"/>
        <ToolBar>
            <ToolBar.Resources>
                <Style x:Key="IconText" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                </Style>
            </ToolBar.Resources>

            <Button x:Name="UpdateButton"
                    Click="UpdateButton_Click"
                    ToolTip="Update InstanceHierarchy — push pending FPB.js viewer edits into this IH. Editor save (Ctrl+S) afterwards persists to disk.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE895;" Foreground="#E08020"/>
                    <TextBlock Text="Update" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    ToolTip="Refresh from AML — re-render this viewer from the current AML document state.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Foreground="#2070C0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- View only: the diagram takes no edits (FPB.js read-only mode).
                 Applies to all tabs and is remembered; Update, the Process menu
                 and the exports stay, they are asked for explicitly. -->
            <ToggleButton x:Name="ViewOnlyToggle"
                          Checked="ViewOnlyToggle_Changed"
                          Unchecked="ViewOnlyToggle_Changed"
                          ToolTip="View only: look at the diagram, zoom, switch layers and export, but change nothing. Click again to edit.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    <TextBlock Text="View only" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>
            <Separator/>
            <!-- What a session needs every time stays a button of its own.
                 Creating, importing and exporting happen now and then, so they
                 share one menu, and the toolbar does not grow with every command
                 added later. They are deliberately not on the editor toolbar:
                 it shows the commands of one plugin at a time, which put the
                 Petri net commands into this tab or doubled these. -->
            <Button x:Name="ProcessMenuButton"
                    Click="ProcessMenuButton_Click"
                    ToolTip="Create, import or export an FPD process.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE700;" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    <TextBlock Text="Process &#x25BE;" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu x:Name="ProcessMenu">
                        <MenuItem x:Name="NewProcessItem"
                                  Header="New Process"
                                  ToolTip="Create an empty FPD InstanceHierarchy in the current AML document."/>
                        <MenuItem x:Name="ImportItem"
                                  Header="Import FPB.js JSON..."
                                  ToolTip="Load an FPB.js JSON file and add its FPD content as a new InstanceHierarchy."/>
                        <Separator/>
                        <MenuItem Header="Export JSON..."
                                  ToolTip="Save this InstanceHierarchy's FPD content as an FPB.js JSON file."
                                  Click="ExportButton_Click"/>
                        <MenuItem Header="Export Conformance Report..."
                                  ToolTip="Write a machine-readable VDI 3682 validation summary (JSON) for CI pipelines, audit logs and paper appendices."
                                  Click="ConformanceButton_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </ToolBar>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bars above the diagram take a row of their own: WPF cannot draw
                 over the WebView2 (airspace). -->
            <StackPanel Grid.Row="0">
                <!-- 016f E3, V28: the InstanceHierarchy changed in the editor while
                     the diagram had changes that are not applied -->
                <Border x:Name="ConflictBar"
                        Visibility="Collapsed"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                        BorderThickness="0,0,0,2"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="ConflictMessage"
                                   Text="The InstanceHierarchy was changed in the editor. The diagram has changes that are not in it yet."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                x:Name="ApplyDiagramButton"
                                Content="Apply diagram"
                                Click="ApplyDiagramButton_Click"
                                Margin="12,0,0,0"
                                Padding="8,2"/>
                        <Button Grid.Column="3"
                                x:Name="ReloadFromAmlButton"
                                Content="Reload from AML"
                                Click="ReloadFromAmlButton_Click"
                                Margin="8,0,0,0"
                                Padding="8,2"/>
                    </Grid>
                </Border>
                <Border x:Name="JsErrorBanner"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                        BorderThickness="0,0,0,2"
                        Padding="12,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="JsErrorMessage"
                                   Text=""
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                x:Name="JsErrorRetryButton"
                                Content="Refresh from AML"
                                Click="JsErrorRetryButton_Click"
                                Margin="12,0,0,0"
                                Padding="8,2"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- keys stay in the diagram (V24, DiagramWebView); AllowExternalDrop is
                 set in the constructor, see there -->
            <local:DiagramWebView Grid.Row="1" x:Name="WebView"/>
            <Border Grid.Row="1"
                    x:Name="WebViewPlaceholder"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    Visibility="Visible">
                <TextBlock Text="Loading FPB.js viewer…"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                           FontSize="13"/>
            </Border>
        </Grid>

        <!-- Splitter between the viewer and the findings list. Users can drag it
             to enlarge / collapse the findings pane. -->
        <GridSplitter Grid.Row="2"
                      Height="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="{DynamicResource MahApps.Brushes.Gray7}"
                      ShowsPreview="True"/>

        <!-- Findings pane: live VDI 3682 validation results for this IH. Double-
             clicking a row asks the viewer to select + scroll to the element. -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource MahApps.Brushes.Gray10}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                    BorderThickness="0,1,0,1"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="VDI 3682 Findings"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="FindingsSummary"
                               Text=" — no findings"
                               Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="1"
                      x:Name="FindingsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="22"
                      FontSize="12"
                      MouseDoubleClick="FindingsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="32" SortMemberPath="SeverityRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SeverityGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{Binding SeverityBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding SeverityName}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="220"/>
                    <DataGridTextColumn Header="Element" Binding="{Binding ElementLabel}" Width="160"/>
                    <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="120"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
