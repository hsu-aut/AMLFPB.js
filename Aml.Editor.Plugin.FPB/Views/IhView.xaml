<UserControl
    x:Class="Aml.Editor.Plugin.FPB.Views.IhView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    mc:Ignorable="d"
    d:DesignHeight="500" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160" MinHeight="60"/>
        </Grid.RowDefinitions>

        <!-- Local toolbar: compact icon buttons matching the editor's native side
             panels (Segoe MDL2 Assets glyphs in coloured boxes, mouse-over reveals
             the action label via tooltip). -->
        <ToolBar Grid.Row="0">
            <ToolBar.Resources>
                <Style x:Key="IconText" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                </Style>
            </ToolBar.Resources>

            <Button x:Name="UpdateButton"
                    Click="UpdateButton_Click"
                    ToolTip="Update InstanceHierarchy — push pending FPB.js viewer edits into this IH. Editor save (Ctrl+S) afterwards persists to disk.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE895;" Foreground="#E08020"/>
                    <TextBlock Text="Update" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    ToolTip="Refresh from AML — re-render this viewer from the current AML document state.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Foreground="#2070C0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button x:Name="ExportButton"
                    Click="ExportButton_Click"
                    ToolTip="Export JSON — save this InstanceHierarchy's FPD content as an FPB.js JSON file.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE78C;" Foreground="#608060"/>
                    <TextBlock Text="Export" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <TextBlock x:Name="StatusLabel"
                       Text=""
                       VerticalAlignment="Center"
                       Foreground="#666"
                       FontStyle="Italic"
                       Margin="6,0"/>
        </ToolBar>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView"/>
            <Border x:Name="WebViewPlaceholder"
                    Background="#F8F8F8"
                    Visibility="Visible">
                <TextBlock Text="Loading FPB.js viewer…"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#666"
                           FontSize="13"/>
            </Border>
            <Border x:Name="JsErrorBanner"
                    Background="#FFF3CD"
                    BorderBrush="#FFE69C"
                    BorderThickness="0,0,0,1"
                    Padding="12,8"
                    Visibility="Collapsed"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#856404"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1"
                               x:Name="JsErrorMessage"
                               Text=""
                               TextWrapping="Wrap"
                               Foreground="#856404"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            x:Name="JsErrorRetryButton"
                            Content="Refresh from AML"
                            Click="JsErrorRetryButton_Click"
                            Margin="12,0,0,0"
                            Padding="8,2"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Splitter between the viewer and the findings list. Users can drag it
             to enlarge / collapse the findings pane. -->
        <GridSplitter Grid.Row="2"
                      Height="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#DDDDDD"
                      ShowsPreview="True"/>

        <!-- Findings pane: live VDI 3682 validation results for this IH. Double-
             clicking a row asks the viewer to select + scroll to the element. -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#F4F4F4"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,1,0,1"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="#666"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="VDI 3682 Findings"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="FindingsSummary"
                               Text=" — no findings"
                               Foreground="#666"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="1"
                      x:Name="FindingsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="22"
                      FontSize="12"
                      MouseDoubleClick="FindingsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="32" SortMemberPath="SeverityRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SeverityGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{Binding SeverityBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding SeverityName}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="220"/>
                    <DataGridTextColumn Header="Element" Binding="{Binding ElementLabel}" Width="160"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
