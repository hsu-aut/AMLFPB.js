<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.6.19</Version>
    <Title>AMLFPB.js</Title>
    <Description>AutomationML Editor plugin for editing VDI 3682 Formalised Process Description (FPD) models. Embeds the FPB.js diagram canvas with live two-way sync between the diagram and the AML tree.</Description>
    <PackageTags>AMLEditor; AMLEditorPlugin.Net; AutomationML; FPB; VDI3682</PackageTags>
    <Authors>VDI 3682 Project</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <BaseOutputPath>$(SolutionDir)build\Plugins\$(MSBuildProjectName)</BaseOutputPath>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

    <!-- Where FPB.JS dist/ lives (relative to this csproj) -->
    <FpbJsDistDir>..\..\..\FPB.JS\dist</FpbJsDistDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Editor-side dependencies are pinned to exact versions. A drift here (the
      editor publishes a 4.4 or 2.4 NuGet) silently changes the surface the
      plugin reflects against (SaveAMLCommand, ApplicationTheme, INotifyAML
      DocumentLoad) without compile errors, so we lock and bump manually.
    -->
    <PackageReference Include="Aml.Editor.Plugin.Contract" Version="[4.3.0]">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Aml.Engine" Version="[4.*, 5.0.0)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Aml.Editor.API" Version="[2.3.0]">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Aml.Skins" Version="2.*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- WebView2: PrivateAssets=all suppresses NuGet dep in nuspec.
         GeneratePathProperty=true exposes $(PkgMicrosoft_Web_WebView2) so we can
         pack the actual DLLs ourselves from the NuGet cache below. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" GeneratePathProperty="true">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\fpb-aml-mapper\dotnet\FpbMapper.Conversion\FpbMapper.Conversion.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <!-- OclNet engine: executes the published VDI 3682 Blatt 3 OCL constraints at
         runtime (Vdi3682Validator's OCL pass, toggle: ValidationOptions.UseOclEngine). -->
    <ProjectReference Include="..\..\..\OclNet\src\OclNet.Core\OclNet.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\..\OclNet\src\OclNet.Caex\OclNet.Caex.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The published OCL rule artifacts ship inside the plugin assembly — the
         runtime validates against the exact spec files, not inline copies. -->
    <EmbeddedResource Include="..\..\..\OclNet\spec\vdi3682-pure-rules.ocl">
      <LogicalName>OclRules.vdi3682-pure-rules.ocl</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\OclNet\spec\vdi3682-helpers.ocl">
      <LogicalName>OclRules.vdi3682-helpers.ocl</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ─── Bundle DLLs into nupkg (from $(OutputPath), all guaranteed by the build) ── -->
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).deps.json" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="$(OutputPath)FpbMapper.Conversion.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="$(OutputPath)OclNet.Core.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="$(OutputPath)OclNet.Caex.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="$(OutputPath)Antlr4.Runtime.Standard.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="Metadata.xml" CopyToOutputDirectory="PreserveNewest" />

    <!-- WebView2 DLLs from the NuGet cache (Link ensures CopyToOutputDirectory works) -->
    <None Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll"
          Link="Microsoft.Web.WebView2.Core.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Wpf.dll"
          Link="Microsoft.Web.WebView2.Wpf.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\lib\Microsoft.Web.WebView2.Core.winmd"
          Link="Microsoft.Web.WebView2.Core.winmd"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Pack="true" PackagePath="lib\$(TargetFramework)" />
    <!-- WebView2Loader.dll: NuGet.Pack ignores items pointing at runtimes/win-x64/native/.
         Stage a copy under obj/bundled/ so it looks like a plain content asset. -->
    <None Include="$(IntermediateOutputPath)bundled\WebView2Loader.dll"
          Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Pack="true" PackagePath="lib\$(TargetFramework)\WebView2Loader.dll" />
  </ItemGroup>

  <!-- ─── Ship FPB.JS lib build + index.html as content assets ─────────────────── -->
  <ItemGroup>
    <!-- Pre-flight check: surface a friendly error if FPB.JS hasn't been built yet. -->
    <None Include="$(FpbJsDistDir)\fpbjs.esm.js"
          Link="fpbjs-assets\fpbjs.esm.js"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="lib\$(TargetFramework)\fpbjs-assets\fpbjs.esm.js" />

    <None Include="$(FpbJsDistDir)\css\**\*"
          Link="fpbjs-assets\css\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="lib\$(TargetFramework)\fpbjs-assets\css\%(RecursiveDir)%(Filename)%(Extension)" />

    <None Include="fpbjs-assets\index.html"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="lib\$(TargetFramework)\fpbjs-assets\index.html" />

    <None Include="fpbjs-assets\vendor\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="lib\$(TargetFramework)\fpbjs-assets\vendor\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="VerifyFpbJsDist" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(FpbJsDistDir)\fpbjs.esm.js')"
           Text="FPB.JS dist/ not built. Run 'npm install &amp;&amp; npm run build' in $(FpbJsDistDir)\.." />
  </Target>

  <!-- esm.sh ships react-dom.js with an absolute /react@x/... import that 404s under
       the WebView2 virtual host. Rewrite it to the bare specifier 'react' so the
       importmap in index.html catches it. Idempotent. -->
  <Target Name="PatchVendorReactDom" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_VendorReactDomFile>fpbjs-assets\vendor\react-dom.js</_VendorReactDomFile>
    </PropertyGroup>
    <ReadLinesFromFile Condition="Exists('$(_VendorReactDomFile)')" File="$(_VendorReactDomFile)">
      <Output TaskParameter="Lines" ItemName="_VendorReactDomLines" />
    </ReadLinesFromFile>
    <WriteLinesToFile Condition="Exists('$(_VendorReactDomFile)')"
                      File="$(_VendorReactDomFile)"
                      Lines="@(_VendorReactDomLines->Replace('&quot;/react@17.0.2/es2022/react.mjs&quot;', '&quot;react&quot;')->Replace('&quot;/react@18.3.1/es2022/react.mjs&quot;', '&quot;react&quot;'))"
                      Overwrite="true" />
  </Target>

  <!-- Stage WebView2Loader.dll so NuGet.Pack treats it as a regular content asset.
       Must run before the build so the file exists when MSBuild resolves the None item above. -->
  <Target Name="StageWebView2Loader" BeforeTargets="BeforeResolveReferences">
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFolder="$(IntermediateOutputPath)bundled\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
