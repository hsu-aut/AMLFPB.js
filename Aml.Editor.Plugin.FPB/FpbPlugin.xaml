<aml:PluginViewBase
    x:Class="Aml.Editor.Plugin.FPB.FpbPlugin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:aml="clr-namespace:Aml.Editor.Plugin.WPFBase;assembly=Aml.Editor.Plugin.Contract"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900">

    <!-- The tab headers are a bit smaller than the skin's default, which does
         not sit well in nested tabs. A header of its own sizes the text and keeps
         the skin's TabItem style; a Style TargetType="TabItem" without BasedOn
         replaced that style and broke the dark theme (016f E3, V17). -->

    <TabControl>
        <!-- Tab 1: per-IH sub-tabs -->
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="FPB.js Viewer" FontSize="12"/>
            </TabItem.Header>
            <Grid>
                <!-- Let the editor's Aml.Skins theme own the appearance — no custom
                     TabControl style here. Tab headers are plain strings so the
                     skin's TabItem template applies cleanly. -->
                <TabControl x:Name="IhTabs"/>
                <Border x:Name="NoIhPlaceholder"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="500">
                            Open an AML document with at least one InstanceHierarchy that contains an FPD_Process. Each FPD-bearing InstanceHierarchy will appear as its own tab here.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button x:Name="PlaceholderNewProcessButton"
                                    Content="New Process"
                                    Padding="10,3"
                                    Margin="0,0,8,0"
                                    ToolTip="Create an empty FPD InstanceHierarchy in the current AML document."/>
                            <Button x:Name="PlaceholderImportButton"
                                    Content="Import FPB.js JSON..."
                                    Padding="10,3"
                                    ToolTip="Load an FPB.js JSON file and add its FPD content as a new InstanceHierarchy."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- Tab 2: status log + diagnostics controls -->
        <TabItem>
            <TabItem.Header>
                <TextBlock Text="Status / Diagnostics" FontSize="12"/>
            </TabItem.Header>
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="FPB.js Import/Export (VDI 3682)"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <Border x:Name="CompatBanner"
                            Visibility="Collapsed"
                            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,2"
                            Margin="12,0,0,0"
                            ToolTip="Editor-API compatibility check ran at startup. Hover or open the log file for details.">
                        <TextBlock x:Name="CompatBannerText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="DebugToggle"
                                  Content="Verbose debug logging"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Checked="DebugToggle_Changed"
                                  Unchecked="DebugToggle_Changed"/>
                        <CheckBox x:Name="AutoSaveToggle"
                                  Content="Auto-save editor after Update InstanceHierarchy"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Checked="AutoSaveToggle_Changed"
                                  Unchecked="AutoSaveToggle_Changed"/>
                        <CheckBox x:Name="ConfirmLargeUpdatesToggle"
                                  Content="Confirm large updates"
                                  VerticalAlignment="Center"
                                  ToolTip="When the snapshot would add/remove more elements or connections than the threshold, ask for confirmation before applying."
                                  Margin="0,0,8,0"
                                  Checked="ConfirmLargeUpdatesToggle_Changed"
                                  Unchecked="ConfirmLargeUpdatesToggle_Changed"/>
                        <TextBlock Text="(threshold:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBox x:Name="SafetyThresholdInput"
                                 Width="40"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Right"
                                 ToolTip="Adds + removes above this number trigger the confirmation dialog. Set 0 to confirm every update."
                                 LostFocus="SafetyThresholdInput_LostFocus"
                                 KeyDown="SafetyThresholdInput_KeyDown"/>
                        <TextBlock Text=")"
                                   VerticalAlignment="Center"
                                   Margin="2,0,12,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenLogFolderButton"
                                Content="Open log folder"
                                Padding="8,2"
                                Click="OpenLogFolderButton_Click"/>
                        <TextBlock x:Name="LogFilePathLabel"
                                   Text=""
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <TextBox Grid.Row="2"
                         x:Name="StatusLog"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="11"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                         Padding="4"
                         Text="Ready. Each FPD InstanceHierarchy in the open AML document gets its own tab in the FPB.js Viewer tab; per-IH Update/Refresh/Export buttons live inside that tab."/>
            </Grid>
        </TabItem>
    </TabControl>
</aml:PluginViewBase>
